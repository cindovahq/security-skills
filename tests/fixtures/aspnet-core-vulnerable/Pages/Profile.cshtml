@page
@model Acme.Portal.Pages.ProfileModel
@{
    ViewData["Title"] = "Your profile";
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

@if (!string.IsNullOrEmpty(Model.Input.AvatarPath))
{
    <img src="@Model.Input.AvatarPath" alt="Avatar for @Model.Input.DisplayName" class="avatar" />
}

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.DisplayName"></label>
        <input asp-for="Input.DisplayName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.JobTitle"></label>
        <input asp-for="Input.JobTitle" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.PhoneNumber"></label>
        <input asp-for="Input.PhoneNumber" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>

<form asp-controller="Files" asp-action="UploadAvatar" method="post" enctype="multipart/form-data">
    <input type="file" name="file" accept="image/*" />
    <button type="submit" class="btn btn-secondary">Upload avatar</button>
</form>
