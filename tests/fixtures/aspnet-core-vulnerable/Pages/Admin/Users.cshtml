@page
@model Acme.Portal.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Team members";
}

<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr><th>Name</th><th>Email</th><th>Job title</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.DisplayName</td>
            <td>@user.Email</td>
            <td>@user.JobTitle</td>
            <td>
                @if (User.IsInRole("Admin"))
                {
                    <form method="post" asp-page-handler="GrantAdmin" asp-route-userId="@user.Id" class="d-inline">
                        <button class="btn btn-sm btn-outline-primary">Make admin</button>
                    </form>
                    <form method="post" asp-page-handler="Lock" asp-route-userId="@user.Id" class="d-inline">
                        <button class="btn btn-sm btn-outline-danger">Lock</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
